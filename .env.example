# Supabase > Project Settings > Database > Connection string > Transaction pooler (6543)
# 서버에서만 쓰는 비밀값입니다. 저장소에 올리지 말고 Vercel 환경 변수에만 넣으세요.
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres

# 과제 7: Supabase Auth (로그인). Vercel의 Supabase 연동이 자동으로 넣어 준다.
# 공개해도 되는 값이다(브라우저용). 서버 비밀키(service_role)는 이 앱에서 쓰지 않는다.
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhb…생략
